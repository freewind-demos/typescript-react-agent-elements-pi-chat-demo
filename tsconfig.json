{
  "compilerOptions": {
    /* 目标与模块：现代浏览器 + ESNext，交给 Vite/tsx 处理打包 */
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    /* React 19 的新 JSX 转换 */
    "jsx": "react-jsx",
    /* 只做类型检查，不产出文件 */
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    /* 前端与后端同仓库：同时需要 node 与 vite 的类型 */
    "types": ["node", "vite/client"],
    /* 前端所有代码在 src，@/ 指向它，与 components.json 的别名一致 */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
